<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- .NET Framework reads its GC's settings here, not from ServerGarbageCollection and ConcurrentGarbageCollection: a
	     workstation GC that isn't concurrent, as on .NET and as the benchmarks run. -->
	<runtime>
		<gcServer enabled="false" />
		<gcConcurrent enabled="false" />
	</runtime>
</configuration>
