<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
		<TieredPGO>true</TieredPGO>
		<NoWarn>$(NoWarn);CA1822</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Signed with the library's key: its InternalsVisibleTo names this assembly by that public key. -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\src\CsvHelper\CsvHelper.snk</AssemblyOriginatorKeyFile>
		<PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\CsvHelper\CsvHelper.csproj" />
		<!-- For LinqBenchmarks; it also makes the generator write the projections of PackageAsset. -->
		<ProjectReference Include="..\..\src\CsvHelper.Linq\CsvHelper.Linq.csproj" />
		<ProjectReference Include="..\..\src\CsvHelper.Generators\CsvHelper.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="Sep" Version="0.17.1" />
		<PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
	</ItemGroup>

	<!-- The Excel read benchmarks: CsvHelper.Excel, and the readers ExcelPackageAssetsRead compares it with. -->
	<ItemGroup>
		<ProjectReference Include="..\..\src\CsvHelper.Excel\CsvHelper.Excel.csproj" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="ExcelDataReader" Version="3.9.0" />
		<PackageReference Include="MiniExcel" Version="1.46.0" />
		<PackageReference Include="Sylvan.Data.Excel" Version="0.5.8" />
	</ItemGroup>

	<!-- NCsvPerf's package assets data (see Data/README.md), read from the output folder. -->
	<ItemGroup>
		<None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- The source of the workbook generator, whose hash keys its cache: a change to it writes the workbooks again. -->
	<ItemGroup>
		<EmbeddedResource Include="ExcelDataGenerator.cs;ExcelTextWorkbook.cs" LogicalName="ExcelGenerator/%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
