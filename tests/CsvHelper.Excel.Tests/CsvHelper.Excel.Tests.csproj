<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net10.0 runs the net10.0 builds of CsvHelper and CsvHelper.Excel, net8.0 the net8.0 builds, and net48 the net47
		     builds, where the zip writer deflates with DeflateStream and computes every CRC with its own slice-by-8 rather
		     than the GZip trailer and PCLMULQDQ, and where WindowsBase opens the packages written. The netstandard builds
		     are compiled but not run; their zip code is the same as net47's. -->
		<TargetFrameworks>net10.0;net8.0;net48</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Signed with the libraries' key: CsvHelper.Excel's InternalsVisibleTo names this assembly by its public key. -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\src\CsvHelper\CsvHelper.snk</AssemblyOriginatorKeyFile>
		<PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<!-- The package assemblies (System.Memory, System.Buffers, ...) reference older versions of each other; an
		     application gets binding redirects for them, a test library has to ask. -->
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net48'">
		<None Remove="App.config" />
	</ItemGroup>

	<!-- ZipArchive, for TestPackage, which .NET has in its shared framework; and System.IO.Packaging's Package, which
	     ZipStructure opens every written package with on .NET Framework, as the Open XML SDK and ClosedXML do there. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.IO.Compression" />
		<Reference Include="WindowsBase" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	</ItemGroup>

	<!-- The oracles the corpus is compared with: the raw cells, typed values, and an independent streaming reader. -->
	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="ExcelDataReader" Version="3.9.0" />
	</ItemGroup>

	<!-- The CRC-32 the zip writer's own is checked against: a reference in the tests only, not the library. -->
	<ItemGroup>
		<PackageReference Include="System.IO.Hashing" Version="10.0.5" />
	</ItemGroup>

	<!-- The corpus (see Files/README.md), read from the output folder. -->
	<ItemGroup>
		<None Include="Files\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- The written content set, whose workbooks the tests write again and compare with Excel's answers in
	     Files/excel-written. -->
	<ItemGroup>
		<Compile Include="..\..\tools\CsvHelper.Excel.Corpus\Written.cs" Link="Corpus\WrittenSet.cs" />
		<Compile Include="..\..\tools\CsvHelper.Excel.Corpus\WrittenTemplates.cs" Link="Corpus\WrittenTemplates.cs" />
	</ItemGroup>

	<!-- The benchmarks' workbook writers of text and of the report, and NCsvPerf's data, for the tests that check the writers
	     against Excel's files. -->
	<ItemGroup>
		<Compile Include="..\..\bench\CsvHelper.Benchmarks\ExcelTextWorkbook.cs" Link="Bench\ExcelTextWorkbook.cs" />
		<Compile Include="..\..\bench\CsvHelper.Benchmarks\ExcelReport.cs" Link="Bench\ExcelReport.cs" />
		<Compile Include="..\..\bench\CsvHelper.Benchmarks\ExcelReportWorkbook.cs" Link="Bench\ExcelReportWorkbook.cs" />
		<None Include="..\..\bench\CsvHelper.Benchmarks\Data\PackageAssets.csv" Link="Bench\PackageAssets.csv" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- The typed benchmark's workbook writer and orders, for the test that checks them against Excel's file. They need
	     .NET's double formatting and Random.NextInt64, so they aren't built for net48. -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net48'">
		<Compile Include="..\..\bench\CsvHelper.Benchmarks\ExcelTypedWorkbook.cs" Link="Bench\ExcelTypedWorkbook.cs" />
		<Compile Include="..\..\bench\CsvHelper.Benchmarks\ExcelOrders.cs" Link="Bench\ExcelOrders.cs" />
		<Compile Include="..\..\bench\CsvHelper.Benchmarks\OrderRecord.cs" Link="Bench\OrderRecord.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\CsvHelper.Excel\CsvHelper.Excel.csproj" />
		<!-- For the gate tests: reader.Query<T>() over a sheet. It also makes the generator write projections. -->
		<ProjectReference Include="..\..\src\CsvHelper.Linq\CsvHelper.Linq.csproj" />
		<!-- The [CsvRecord] generator, for the generated mappers of the test types. -->
		<ProjectReference Include="..\..\src\CsvHelper.Generators\CsvHelper.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
