<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Generates the documentation site (docs/_site) from the README, docs/pages, the built library and its XML
		     docs, and the git tags. Run it through docs/build.ps1, which also builds the CSS. -->
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<RootNamespace>CsvHelper.Docs</RootNamespace>
		<AssemblyName>CsvHelper.Docs</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Markdig" Version="1.4.1" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageReference Include="NuGet.Versioning" Version="7.9.0" />
	</ItemGroup>

</Project>
