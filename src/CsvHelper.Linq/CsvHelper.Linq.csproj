<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- The same targets as CsvHelper, whose builds it runs on. -->
		<TargetFrameworks>net10.0;netstandard2.1;netstandard2.0;net47</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RootNamespace>CsvHelper.Linq</RootNamespace>
		<AssemblyName>CsvHelper.Linq</AssemblyName>
		<Description>A LINQ provider for CsvHelper: queries that read only the columns and rows they use, join with other LINQ providers, and write their results as CSV.</Description>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>Josh Close</Authors>
		<Copyright>Copyright © 2009-2026 Josh Close</Copyright>
		<PackageId>CsvHelper.Linq</PackageId>
		<PackageTags>csv;csvhelper;linq;iqueryable;query;comma;separated;value;delimited</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageProjectUrl>https://joshclose.github.io/CsvHelper/</PackageProjectUrl>
		<PackageReleaseNotes>https://joshclose.github.io/CsvHelper/changelog.html</PackageReleaseNotes>
		<PackageLicenseExpression>MS-PL OR Apache-2.0</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/JoshClose/CsvHelper</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Strong named with CsvHelper's key, like CsvHelper itself: strong named assemblies can reference it. -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>..\CsvHelper\CsvHelper.snk</AssemblyOriginatorKeyFile>
		<PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
		<!-- The query provider compiles expressions and needs reflection, which its public types say with
		     [RequiresDynamicCode] and [RequiresUnreferencedCode]; the analyzers check that nothing else does. -->
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<!-- PrivateAssets none: the package's dependency on CsvHelper keeps its analyzers, so the [CsvRecord] generator
		     reaches applications that reference only CsvHelper.Linq. -->
		<ProjectReference Include="..\CsvHelper\CsvHelper.csproj" PrivateAssets="none" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\CsvHelper\Icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CsvHelper.Linq.Tests" Key="" />
	</ItemGroup>

</Project>
