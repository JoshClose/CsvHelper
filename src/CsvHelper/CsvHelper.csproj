<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net10.0 and net8.0 are the SIMD builds (net8.0 for .NET 8/9: generic math for Parse<T>, and SIMD without the
		     AVX-512 VBMI2 compress, which needs .NET 10). netstandard2.1, netstandard2.0 and net47 (same code, see
		     Polyfills/) use the portable 64-bit integer scanner. netstandard2.1 has spans and async streams built in, so it
		     needs no System.Memory package: .NET Core 3.0 to 7 and Mono use it, and Unity 2021.2+, where that package clashes
		     with the built-in types. net47 avoids the facade problems of .NET Standard libraries on .NET Framework 4.7/4.7.1. -->
		<TargetFrameworks>net10.0;net8.0;netstandard2.1;netstandard2.0;net47</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RootNamespace>CsvHelper</RootNamespace>
		<AssemblyName>CsvHelper</AssemblyName>
		<Description>A SIMD accelerated, allocation free CSV reader and RFC 4180 writer for .NET.</Description>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The NuGet package. ContinuousIntegrationBuild only on CI, so local builds keep real source paths. -->
		<Authors>Josh Close</Authors>
		<Copyright>Copyright © 2009-2026 Josh Close</Copyright>
		<PackageId>CsvHelper</PackageId>
		<PackageTags>csv;csvhelper;comma;separated;value;delimited</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageProjectUrl>https://joshclose.github.io/CsvHelper/</PackageProjectUrl>
		<PackageReleaseNotes>https://joshclose.github.io/CsvHelper/changelog.html</PackageReleaseNotes>
		<PackageLicenseExpression>MS-PL OR Apache-2.0</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryUrl>https://github.com/JoshClose/CsvHelper</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Strong named with CsvHelper 33's key, so the assembly keeps its identity. The tests and benchmarks are signed
		     with it too: InternalsVisibleTo names them by this public key. -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>CsvHelper.snk</AssemblyOriginatorKeyFile>
		<PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
		<CsvHelperPublicKey></CsvHelperPublicKey>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net47'">
		<PackageReference Include="System.Memory" Version="4.5.5" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- The source generator of [CsvRecord] types: built with the library and packed as its analyzer, so package
		     consumers get it automatically. Projects that reference this project add it as an analyzer themselves. -->
		<ProjectReference Include="..\CsvHelper.Generators\CsvHelper.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\CsvHelper.Generators\bin\$(Configuration)\netstandard2.0\CsvHelper.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CsvHelper.Tests" Key="$(CsvHelperPublicKey)" />
		<InternalsVisibleTo Include="CsvHelper.Benchmarks" Key="$(CsvHelperPublicKey)" />
	</ItemGroup>

</Project>
